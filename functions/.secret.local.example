# Secretos para los emuladores locales.
# Copia este archivo como `functions/.secret.local` (está en .gitignore) y
# rellena los valores. En producción NO se usa: allí van en Secret Manager con
#   firebase functions:secrets:set NOMBRE

PABILO_API_KEY=
PABILO_USER_BANK_ID=
INEFABLE_API_KEY=
FAZERCARDS_API_KEY=

# Central One: llave `co_live_…` (permisos catalog:read, balance:read,
# orders:read, orders:write y codes:read) y el secreto HMAC del webhook que
# muestra el portal al registrar la URL. Sin el secreto (o con `PENDIENTE`)
# la ruta del webhook responde 503.
CENTRAL_ONE_API_KEY=
CENTRAL_ONE_WEBHOOK_SECRET=

# API Key de Resend para envío de correos transaccionales (smtp.resend.com)
RESEND_API_KEY=

# Token temporal para /api/setup/bootstrap. Inventa una cadena larga y
# elimínalo cuando ya tengas tu administrador.
SETUP_TOKEN=
